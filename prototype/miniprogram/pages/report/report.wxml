<view class="report-page" wx:if="{{!loading && profile && plan}}">
  <report-section
    profile="{{profile}}"
    plan="{{plan}}"
    aiText="{{aiText}}"
    volunteerUnit="{{volunteerUnit}}"
  ></report-section>
</view>

<view class="report-empty" wx:elif="{{loading}}">
  <text class="empty-icon">📊</text>
  <text class="empty-text">加载报告数据...</text>
</view>

<view class="report-empty" wx:else>
  <text class="empty-icon">📋</text>
  <text class="empty-text">暂无报告数据</text>
  <text class="empty-hint">请先在「志愿方案」页面生成方案</text>
</view>
