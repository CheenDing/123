.score-bar {
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.score-bar-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.score-bar-head--center {
  justify-content: center;
}

.score-bar-label {
  font-size: 26rpx;
  color: #6f675c;
}

.score-bar-level {
  font-size: 24rpx;
  font-weight: 600;
}

.score-bar-track {
  height: 14rpx;
  border-radius: 999rpx;
  background: #e3d9c6;
  overflow: hidden;
}

.score-bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #b08d57;
  transition: width 0.3s ease;
}
