@import "../volunteer-card/volunteer-card.wxss";

.school-group-card {
  border-left: 4rpx solid #b08d57;
}

/* Major chip rows */
.major-chips {
  padding: 0 24rpx 12rpx;
}

.major-chip-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid #efe9db;
  cursor: pointer;
}

.major-chip-row.expanded {
  background: #faf8f2;
  margin: 0 -24rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
}

.major-chip-name {
  font-size: 24rpx;
  color: #1e1b16;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.major-chip-meta {
  font-size: 22rpx;
  color: #a89f90;
  flex-shrink: 0;
}

/* 分数徽标：墨黑实心 */
.major-chip-score {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 60rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: #1e1b16;
  color: #f7f2e7;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.major-row-chevron {
  font-size: 24rpx;
  color: #a89f90;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.major-row-chevron.open {
  transform: rotate(90deg);
}

.major-row-detail {
  padding: 0 0 16rpx 0;
}

/* Weighted history note */
.history-note-weight {
  display: block;
  font-size: 20rpx;
  color: #8a6a3b;
  background: #f6efdd;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.history-mini {
  padding: 0 24rpx 16rpx;
}

.history-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e1b16;
  margin-bottom: 6rpx;
}

.history-scroll {
  width: 100%;
  white-space: nowrap;
}

.history-table {
  min-width: 650rpx;
}

.history-row {
  display: flex;
  border-bottom: 1rpx solid #efe9db;
}

.history-header {
  background: #f3ecdd;
  border-radius: 8rpx 8rpx 0 0;
}

.history-cell {
  flex: 1;
  padding: 12rpx 10rpx;
  font-size: 22rpx;
  text-align: center;
  color: #6f675c;
  white-space: nowrap;
}

.history-header .history-cell {
  font-size: 20rpx;
  color: #8a6a3b;
  font-weight: 500;
}

.cell-year { flex: 0.6; }
.cell-score { flex: 1; }
.cell-rank { flex: 1.2; }
.cell-plan { flex: 0.8; }

.volunteer-card {
  margin-bottom: 20rpx;
}
