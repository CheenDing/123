.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2000;
  background: rgba(30, 27, 22, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 90vw;
  height: 85vh;
  background: #fffdf9;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  padding: 28rpx 28rpx 18rpx;
  border-bottom: 1rpx solid #e3d9c6;
  position: relative;
  flex-shrink: 0;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #a89f90;
  background: #f3ecdd;
  border-radius: 50%;
}

.modal-school {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "SimSun", serif;
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  color: #1e1b16;
  display: block;
  margin-bottom: 6rpx;
  padding-right: 60rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #6f675c;
}

.modal-body {
  flex: 1;
  height: 0;
  padding: 20rpx 28rpx;
}

.modal-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.modal-stat {
  width: calc(50% - 7rpx);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 18rpx;
  background: #faf8f2;
  border: 1rpx solid #efe9db;
  border-radius: 10rpx;
  box-sizing: border-box;
}

.stat-label {
  font-size: 24rpx;
  color: #a89f90;
}

.stat-value {
  font-size: 24rpx;
  font-weight: 600;
  color: #1e1b16;
}

.modal-section {
  padding: 18rpx 0;
  border-top: 1rpx solid #efe9db;
}

.modal-section .section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e1b16;
  margin-bottom: 12rpx;
}

.modal-text {
  font-size: 24rpx;
  color: #6f675c;
  line-height: 1.65;
}

.modal-desc {
  font-size: 24rpx;
  color: #6f675c;
  line-height: 1.65;
  display: block;
}
