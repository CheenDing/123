<view class="modal-overlay" wx:if="{{visible}}" bindtap="onClose">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="modal-close" bindtap="onClose">✕</view>
      <text class="modal-school">{{schoolName}}</text>
      <text class="modal-subtitle">{{location}} · {{ownership}} · {{schoolType}} · 软科第{{softRank}}名</text>
    </view>

    <scroll-view scroll-y class="modal-body">
      <view class="modal-grid">
        <view class="modal-stat"><text class="stat-label">男女比例</text><text class="stat-value">{{maleRatio}}</text></view>
        <view class="modal-stat"><text class="stat-label">保研率</text><text class="stat-value">{{baoyanRate}}</text></view>
        <view class="modal-stat"><text class="stat-label">硕士点</text><text class="stat-value">{{masterPrograms}}个</text></view>
        <view class="modal-stat"><text class="stat-label">博士点</text><text class="stat-value">{{doctoralPrograms}}个</text></view>
        <view class="modal-stat"><text class="stat-label">建校</text><text class="stat-value">{{foundingYear}}年</text></view>
        <view class="modal-stat"><text class="stat-label">城市</text><text class="stat-value">{{cityLevel}}</text></view>
        <view class="modal-stat"><text class="stat-label">软科排名</text><text class="stat-value">{{softRank}}</text></view>
        <view class="modal-stat"><text class="stat-label">满意度</text><text class="stat-value">{{satOverall}}</text></view>
        <view class="modal-stat"><text class="stat-label">院校层次</text><text class="stat-value">{{layerLabel}}</text></view>
        <view class="modal-stat"><text class="stat-label">招生人数</text><text class="stat-value">{{totalPlan}}人</text></view>
      </view>

      <view class="modal-section" wx:if="{{description}}">
        <text class="section-title">📖 学校简介</text>
        <text class="modal-desc">{{description}}</text>
      </view>

      <view class="modal-section" wx:if="{{contentDB}}">
        <text class="section-title">💡 专家点评</text>
        <text class="modal-desc">{{contentDB}}</text>
      </view>

      <view class="modal-section" wx:if="{{nationalMajors}}">
        <text class="section-title">🏆 国家特色专业</text>
        <text class="modal-text">{{nationalMajors}}</text>
      </view>

      <view class="modal-section" wx:if="{{disciplineEval}}">
        <text class="section-title">📊 学科评估</text>
        <text class="modal-text">{{disciplineEval}}</text>
      </view>

      <view class="modal-section" wx:if="{{transferPolicy}}">
        <text class="section-title">🔄 转专业政策</text>
        <text class="modal-text">{{transferPolicy}}</text>
      </view>
    </scroll-view>
  </view>
</view>
