<view class="ai-chat">
  <!-- Header -->
  <view class="ai-chat-header">
    <view class="ai-chat-header-left">
      <image class="ai-avatar" src="/icons/ai-avatar.svg" mode="aspectFill"></image>
      <view>
        <text class="ai-chat-title">AI小助手志愿咨询</text>
        <text class="ai-chat-subtitle">基于AI分析模型</text>
      </view>
    </view>
    <view class="ai-chat-close" bindtap="onClose">✕</view>
  </view>

  <!-- Messages area -->
  <scroll-view scroll-y class="ai-chat-messages" id="msg-list" scroll-into-view="{{scrollToView}}" scroll-with-animation>
    <!-- Welcome / empty state -->
    <view class="ai-chat-welcome" wx:if="{{messages.length === 0}}">
      <text class="welcome-text">你好！我是AI小助手，基于高考数据分析模型为你提供志愿建议。</text>
      <text class="welcome-text">你可以问我：</text>
      <text class="welcome-example">南京大学和浙江大学哪个更适合我？</text>
      <text class="welcome-example">计算机专业就业前景如何？</text>
      <text class="welcome-example">我的志愿方案合理吗？</text>
      <view class="suggested-questions">
        <view class="suggested-btn" wx:for="{{suggestedQuestions}}" wx:key="*this" data-text="{{item}}" bindtap="sendMessage">
          {{item}}
        </view>
      </view>
    </view>

    <!-- Messages -->
    <view class="ai-chat-message {{msg.role}}" wx:for="{{messages}}" wx:key="*this" wx:for-item="msg">
      <view class="ai-chat-avatar">
        <text wx:if="{{msg.role === 'user'}}">👤</text>
        <image wx:else class="avatar-img" src="/icons/ai-avatar.svg" mode="aspectFill"></image>
      </view>
      <view class="ai-chat-bubble">
        <text class="bubble-line" wx:for="{{msg.lines}}" wx:key="*this" wx:for-item="line">{{line}}</text>
      </view>
    </view>

    <!-- Loading -->
    <view class="ai-chat-message assistant" wx:if="{{loading}}">
      <view class="ai-chat-avatar">
        <image class="avatar-img" src="/icons/ai-avatar.svg" mode="aspectFill"></image>
      </view>
      <view class="ai-chat-bubble ai-loading">
        <text>正在思考...</text>
      </view>
    </view>

    <view id="msg-end"></view>
  </scroll-view>

  <!-- Input area -->
  <view class="ai-chat-input">
    <textarea
      class="chat-textarea"
      value="{{input}}"
      bindinput="onInput"
      placeholder="输入你的问题..."
      auto-height
      maxlength="-1"
      disabled="{{loading}}"
    ></textarea>
    <view class="chat-send-btn {{loading || !input.trim() ? 'disabled' : ''}}" bindtap="sendMessage">
      发送
    </view>
  </view>
</view>
